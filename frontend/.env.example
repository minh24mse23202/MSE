# Browser requests use the same-origin /api path by default.
# Change only the server-side Vite proxy target when FastAPI uses another port.
ARAGBIZ_DEV_API_TARGET=http://127.0.0.1:8000

# Optional for deployments that intentionally expose the API at another origin.
# Leave unset for the one-tunnel Microsoft Dev Tunnels workflow.
# VITE_ARAGBIZ_API_URL=https://api.example.com
