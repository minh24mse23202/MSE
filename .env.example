ARAGBIZ_DATABASE_URL=postgresql+psycopg://aragbiz:aragbiz@localhost:5432/aragbiz
ARAGBIZ_KNOWLEDGE_BACKEND=postgres
ARAGBIZ_AUTH_REQUIRED=true
ARAGBIZ_JWT_SECRET=replace-with-a-long-random-secret
ARAGBIZ_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ARAGBIZ_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
ARAGBIZ_GLOBAL_MODEL_BUDGET_USD=25
ARAGBIZ_MODEL_SECRET_KEY=replace-with-a-long-random-model-credential-key

# Connections may reference these environment variables instead of storing credentials.
ARAGBIZ_MODEL_OPENAI_API_KEY=
ARAGBIZ_MODEL_COHERE_API_KEY=
ARAGBIZ_MODEL_OPENROUTER_API_KEY=
ARAGBIZ_MODEL_GEMINI_API_KEY=

# Ollama and vLLM normally use local endpoint URLs and do not require credentials.
# Credentials entered in the AI Models screen are encrypted with ARAGBIZ_MODEL_SECRET_KEY.
