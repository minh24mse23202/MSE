ARAGBIZ_DATABASE_URL=postgresql+psycopg://aragbiz:aragbiz@localhost:5432/aragbiz
ARAGBIZ_KNOWLEDGE_BACKEND=postgres
ARAGBIZ_AUTH_REQUIRED=true
ARAGBIZ_JWT_SECRET=replace-with-a-long-random-secret
ARAGBIZ_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ARAGBIZ_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
ARAGBIZ_GLOBAL_MODEL_BUDGET_USD=25
# Credentials entered in the AI Models screen are encrypted with ARAGBIZ_MODEL_SECRET_KEY.
ARAGBIZ_MODEL_SECRET_KEY=replace-with-a-long-random-model-credential-key
# Used only when ARAGBIZ_KNOWLEDGE_BACKEND=json; PostgreSQL stores analytics in relational tables.
ARAGBIZ_ANALYTICS_STORE=data/knowledge/analytics_store.json

ARAGBIZ_CONVERSATION_MAX_EXCHANGES=6
ARAGBIZ_CONVERSATION_MAX_CHARACTERS=10000
ARAGBIZ_T5_CLASSIFIER_MODEL_PATH=data/artifacts/query_classifier_t5
ARAGBIZ_DISTILBERT_V2_CLASSIFIER_MODEL_PATH=data/artifacts/query_classifier_distilbert_v2
ARAGBIZ_T5_V2_CLASSIFIER_MODEL_PATH=data/artifacts/query_classifier_t5_v2

# Prepared WixQA corpus import and batched Knowledge Base embedding.
ARAGBIZ_WIXQA_KB_CORPUS=data/processed/wix_kb_corpus_documents.jsonl
ARAGBIZ_KNOWLEDGE_EMBED_BATCH_SIZE=64

# Full-fidelity RAG trace artifacts are gzip-compressed and retained for 30 days.
ARAGBIZ_TRACE_STORE=data/traces
ARAGBIZ_TRACE_RETENTION_DAYS=30
ARAGBIZ_TRACE_MAX_BYTES=10485760
